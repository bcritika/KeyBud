# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard > Project Settings > API). Restart `npm start` after changing it.
# The anon key is meant to be public: row level security in the database protects the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
